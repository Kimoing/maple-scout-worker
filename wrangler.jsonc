{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maple-scout-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "APP_ORIGINS": "http://localhost:3000,https://vigilant-waffle-775qwj6wqg7xhjjp-3000.app.github.dev"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maple-scout-db",
      "database_id": "51378fd6-ae13-4084-bb5b-9f8bcd2e3a0c",
      "migrations_dir": "migrations"
    }
  ]
}