{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maple-scout-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "APP_ORIGINS": "http://localhost:3000,http://localhost:3001,https://vigilant-waffle-775qwj6wqg7xhjjp-3000.app.github.dev,https://opulent-xylophone-6vwg7qprqjwpc49rg-3000.app.github.dev,https://opulent-xylophone-6vwg7qprqjwpc49rg-3001.app.github.dev"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maple-scout-db",
      "database_id": "51378fd6-ae13-4084-bb5b-9f8bcd2e3a0c",
      "migrations_dir": "migrations"
    }
  ]
}